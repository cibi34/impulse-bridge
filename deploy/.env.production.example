# IMPULSE Curator — production .env for Docker deployment.
#
# Copy this to /srv/impulse-bridge/.env on the VM and fill in real values.
# Compose reads it twice: for the ${...} values in docker-compose.yml (it's
# named .env and lives next to it), and as `env_file`, which passes every
# variable into the container. The file itself is not part of the image.

# ---- Routing (consumed by docker-compose.yml labels) ----
# Public hostname that Traefik should route to. Must match your DNS A record.
BRIDGE_DOMAIN=impulse-bridge.octo-code.de

# HTTP Basic Auth string for the /admin, /docs and /openapi.json paths.
#
# Generate (on the VM after Docker is installed) with:
#
#     docker run --rm httpd:2.4 htpasswd -nbB admin "your-password" | sed 's/\$/\$\$/g'
#
# The trailing `sed` doubles every $ — docker-compose treats $ as a variable
# reference, and we need the htpasswd hash to survive intact. Paste the result
# below (it will look like  admin:$$2y$$05$$...  with double-dollars).
BRIDGE_BASIC_AUTH=admin:$$2y$$05$$REPLACE_THIS_WITH_REAL_HASH

# ---- Bridge runtime (consumed by the bridge inside the container) ----
BRIDGE_LOG_LEVEL=INFO
BRIDGE_DEFAULT_CACHE_TTL=600

# CORS: origins allowed to call the API from a browser (the web frontend runs
# on a different domain than the bridge). "*" allows any origin — fine for the
# PoC. Tighten to the real frontend origin(s) for production, comma-separated:
#     BRIDGE_CORS_ALLOW_ORIGINS=https://app.example.org
# Only the Impulse API (/collections, /health) is CORS-enabled; the web app
# API and the admin are same-origin only.
BRIDGE_CORS_ALLOW_ORIGINS=*

# Curated collections metadata (published in the Impulse API).
# BRIDGE_COLLECTION_OWNER_ID=impulse-curator
# BRIDGE_DEFAULT_ORGANIZATION=IMPULSE Curator

# Email: SMTP host, sender and the submission address are set in the admin UI
# (Settings). Optionally keep the SMTP password out of the database:
# BRIDGE_SMTP_PASSWORD=

# ---- Upstream API keys ----
EUROPEANA_API_KEY=
