EUROPEANA_API_KEY=
BRIDGE_CONFIG_DIR=configs/sources
BRIDGE_DATA_DIR=data
BRIDGE_LOG_LEVEL=INFO
BRIDGE_DEFAULT_CACHE_TTL=600

# Public address of this server; used in collection URIs, files and email links.
BRIDGE_PUBLIC_BASE_URL=http://localhost:8080

# Email: the SMTP account is set in the admin UI (Settings). For local
# development, log emails (incl. sign-in links) instead of sending them:
BRIDGE_MAIL_LOG_ONLY=true
# Optional: keep the SMTP password out of the database.
# BRIDGE_SMTP_PASSWORD=
